{
	"name": "directus-interface-multi-block-editor",
	"description": "Please enter a description for your extension",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-interface"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.1.4",
		"@editorjs/attaches": "^1.3.0",
		"@editorjs/checklist": "1.6.0",
		"@editorjs/code": "2.9.0",
		"@editorjs/delimiter": "1.4.0",
		"@editorjs/editorjs": "^2.31.6",
		"@editorjs/embed": "2.7.4",
		"@editorjs/header": "2.8.1",
		"@editorjs/image": "2.9.3",
		"@editorjs/inline-code": "1.5.0",
		"@editorjs/nested-list": "1.4.3",
		"@editorjs/paragraph": "2.11.5",
		"@editorjs/quote": "2.6.0",
		"@editorjs/raw": "2.5.0",
		"@editorjs/table": "2.3.0",
		"@editorjs/underline": "1.1.0",
		"sass": "^1.99.0",
		"typescript": "^6.0.3",
		"vue": "^3.5.34"
	},
	"dependencies": {
		"editorjs-toggle-block": "^0.3.16",
		"lodash": "^4.18.1",
		"uuid": "^14.0.0",
		"vue-i18n": "^11.4.4",
		"vue-router": "^4.6.3"
	}
